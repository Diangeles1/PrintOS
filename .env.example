# ---- Supabase (obrigatório) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app (para links em mensagens do WhatsApp). Ex.: https://app.suaempresa.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- WhatsApp (integração de pedidos) ----
# Só o webhook usa. Deixe vazio para desativar a integração.

# service_role key do Supabase (Project Settings > API). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# token que você inventa e repete na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta > Configurações do app > Básico). Valida a assinatura do webhook.
WHATSAPP_APP_SECRET=

# Número do bot mostrado em Configurações (só dígitos, DDI+DDD+número). Ex.: 5579999990000
NEXT_PUBLIC_WHATSAPP_BOT_NUMERO=

# ---- SuperADMIN ----
# E-mails (vírgula) que podem acessar /admin. Deixe vazio para desativar o painel.
SUPERADMIN_EMAILS=
